# Copy to .env.local for local development. All are optional; set them in Vercel for production.

# Public site URL (canonical links, sitemap). Defaults to https://guideisetzg.tn
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=
